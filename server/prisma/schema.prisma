generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model FunctionEntry {
  id          Int      @id @default(autoincrement())
  name        String
  description String?

  language String
  category String?

  categoryId   Int?
  categoryNode Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sourceClassId Int?
  sourceClass   CodeClass? @relation("ClassMethods", fields: [sourceClassId], references: [id], onDelete: SetNull)

  sourceFileId Int?
  sourceFile   CodeFile? @relation("FileFunctions", fields: [sourceFileId], references: [id], onDelete: SetNull)

  extracted Boolean @default(false)

  variants FunctionVariant[]
  tags     Tag[]

  relatedFunctions FunctionEntry[] @relation("FunctionRelations")
  relatedBy        FunctionEntry[] @relation("FunctionRelations")

  favorite       Boolean @default(false)
  learningStatus String  @default("unlearned")
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FunctionVariant {
  id          Int    @id @default(autoincrement())
  name        String
  language    String @default("plaintext")
  code        String
  explanation String?

  sourceName String?
  sourceUrl  String?

  functionId Int
  function   FunctionEntry @relation(fields: [functionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CodeProject {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  language    String   @default("dart")

  categoryId   Int?
  categoryNode Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  files CodeFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CodeFile {
  id          Int      @id @default(autoincrement())
  name        String
  language    String   @default("plaintext")
  code        String
  description String?

  projectId   Int?
  project     CodeProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectPath String?

  categoryId   Int?
  categoryNode Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  classes   CodeClass[]
  functions FunctionEntry[] @relation("FileFunctions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, projectPath])
}

model CodeClass {
  id          Int      @id @default(autoincrement())
  name        String
  language    String   @default("plaintext")
  code        String
  description String?

  categoryId   Int?
  categoryNode Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sourceFileId Int?
  sourceFile   CodeFile? @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  methods FunctionEntry[] @relation("ClassMethods")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  functions FunctionEntry[]
  classes   CodeClass[]
  files     CodeFile[]
  projects  CodeProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, name])
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  functions FunctionEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
